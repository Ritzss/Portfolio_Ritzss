{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "MONGODB_URI",
        "ADMIN_SESSION_SECRET",
        "ADMIN_USERNAME",
        "ADMIN_PASSWORD",
        "ADMIN_SETUP_SECRET",
        "FEEDBACK_RATE_LIMIT_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}